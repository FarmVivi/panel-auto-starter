<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>fr.farmvivi.panel-auto-starter</groupId>
        <artifactId>panel-auto-starter-parent</artifactId>
        <version>3.4.3-SNAPSHOT</version>
    </parent>

    <artifactId>panel-auto-starter-velocity</artifactId>
    <name>PanelAutoStarter-Velocity</name>
    <description>Velocity proxy plugin implementation for Panel Auto Starter</description>

    <dependencies>
        <!-- Panel Auto Starter Common -->
        <dependency>
            <groupId>fr.farmvivi.panel-auto-starter</groupId>
            <artifactId>panel-auto-starter-common</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- Adventure Text Serializer Legacy -->
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-serializer-legacy</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- Velocity API -->
        <dependency>
            <groupId>com.velocitypowered</groupId>
            <artifactId>velocity-api</artifactId>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>fr.farmvivi.panelautostarter.velocity.VelocityPlugin</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!-- Velocity charge les classes d'un plugin en
                                 parent-first : tout ce que le proxy embarque
                                 deja masque notre copie, qui n'est jamais
                                 chargee. Adventure, slf4j et leurs annotations
                                 en font partie (verifie classe par classe contre
                                 le jar de Velocity 4.3.1). Les shader ne ferait
                                 que grossir le jar. bungeecord-config, lui,
                                 reste : Velocity ne l'a pas. -->
                            <artifactSet>
                                <excludes>
                                    <exclude>net.kyori:*</exclude>
                                    <exclude>org.slf4j:*</exclude>
                                    <exclude>org.jetbrains:annotations</exclude>
                                    <exclude>org.jspecify:jspecify</exclude>
                                    <exclude>com.google.auto.service:auto-service-annotations</exclude>
                                </excludes>
                            </artifactSet>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>fr.farmvivi.panelautostarter.velocity.VelocityPlugin</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>templating-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>filter-src</id>
                        <goals>
                            <goal>filter-sources</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
